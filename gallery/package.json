{
  "name": "litt-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "litt.md components gallery: a tuning instrument for motion, then a library.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "lint:litt": "node scripts/lint-litt.mjs",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "shot": "node scripts/shot.mjs",
    "verify": "npm run typecheck && npm run lint:litt"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "motion": "12.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
