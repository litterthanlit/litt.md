{
  "name": "litt-md-gallery",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "litt.md components gallery: every component on the locked v0.5 tokens, documented and installable, and a Playground for tuning motion.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "lint:litt": "node scripts/lint-litt.mjs",
    "test:lint": "node scripts/lint-litt.mjs --self-test",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "gen:docs": "node scripts/gen-docs.mjs",
    "gen:registry": "node scripts/gen-registry.mjs",
    "predev": "npm run -s sync:tokens && npm run -s gen:docs",
    "prebuild": "npm run -s sync:tokens && npm run -s gen:docs && npm run -s gen:registry",
    "shot": "node scripts/shot.mjs",
    "test:registry": "node scripts/test-registry.mjs",
    "test:agents": "node scripts/test-agents.mjs",
    "test:a11y": "node scripts/a11y.mjs",
    "verify": "npm run -s sync:tokens && npm run -s gen:docs && npm run -s gen:registry && npm run -s typecheck && npm run -s lint:litt && npm run -s test:lint"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.21",
    "@radix-ui/react-context-menu": "2.3.8",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-scroll-area": "1.3.0",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-slider": "1.5.0",
    "@radix-ui/react-switch": "1.3.8",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "motion": "12.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sugar-high": "2.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
